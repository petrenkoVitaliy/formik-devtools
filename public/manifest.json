{
    "manifest_version": 3,
    "name": "Formik Devtools",
    "description": "Formik Developer Tools for debugging React form components",
    "version": "0.4.0",
    "permissions": ["storage"],
    "devtools_page": "devtools.html",
    "action": {
        "default_icon": {
            "16": "16.png",
            "48": "48.png",
            "128": "128.png"
        }
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["scripts/content.js"],
            "run_at": "document_start",
            "all_frames": true
        }
    ],
    "background": {
        "service_worker": "scripts/background.js"
    },
    "web_accessible_resources": [
        {
            "resources": ["scripts/war.js"],
            "matches": ["<all_urls>"]
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
        "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self'; worker-src blob:"
    }
}
